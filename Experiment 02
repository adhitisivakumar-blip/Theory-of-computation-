
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, state = 0;

    printf("Enter a binary string: ");
    scanf("%s", str);

    if (str[0] != '0') {
        printf("String Rejected\n");
        return 0;
    }

    state = 1;

    for (i = 1; i < strlen(str); i++) {
        if (str[i] == '0' || str[i] == '1') {
            if (str[i] == '1')
                state = 2;
            else
                state = 1;
        } else {
            printf("String Rejected\n");
            return 0;
        }
    }

    if (state == 2)
        printf("String Accepted\n");
    else
        printf("String Rejected\n");

    return 0;
}
